{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "silo",
  "version": "1.4.1",
  "identifier": "com.julienblanchon.silo",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NkEyRDU2MzQ2Rjc1QTcKUldTbmRXODBWaTFxMUE1ZTlKb2ZCWGxwM0N3Z01mNGR6TlhYK0Y2NkVFMUJJTGhIMEtYT0V5STMK",
      "endpoints": [
        "https://github.com/julien-blanchon/silo/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "silo",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost http://asset.localhost asset: data: blob:",
        "img-src": "'self' ipc: http://ipc.localhost http://asset.localhost asset:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "asset",
          "default-src",
          "img-src",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}